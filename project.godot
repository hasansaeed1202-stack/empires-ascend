; Engine configuration file.
; Prefer editing this file through Godot's Project Settings UI.
config_version=5

[application]

config/name="Empires Ascend"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Constants="*res://scripts/autoloads/constants.gd"
ResourceStore="*res://scripts/autoloads/resource_store.gd"
SaveSystem="*res://scripts/autoloads/save_system.gd"
GameManager="*res://scripts/autoloads/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[layer_names]

3d_physics/layer_1="Unit"
3d_physics/layer_2="Building"
3d_physics/layer_3="Terrain"
3d_physics/layer_4="Projectile"
3d_physics/layer_5="ResourceNode"

[input]

camera_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194311)]
}
camera_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194313)]
}
camera_pan_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
camera_pan_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
camera_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
camera_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
camera_rotate_drag={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":3)]
}
selection_primary={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
selection_add={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325), Object(InputEventKey,"physical_keycode":4194326)]
}
command_move={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
command_attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
command_gather={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
ui_cancel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
